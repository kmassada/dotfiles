# ==============================================================================
# Machine-Specific Dotfiles Configuration
# ==============================================================================
# Path: ~/.config/dotfiles/machine.env
#
# This file defines the local machine's identity, prompt icon, color, and role.
# Copy this file to ~/.config/dotfiles/machine.env on each machine to customize.
#
# To automatically configure or audit this file, run:
#   ~/src/dotfiles/scripts/setup-machine.sh
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Machine Identity & Visuals
# ------------------------------------------------------------------------------
# MACHINE_NAME: Human-readable alias for this host (e.g. "macbook-air", "mac-mini", "work-mac")
MACHINE_NAME="macbook-air"

# MACHINE_ICON: The icon rendered on Line 2 of your prompt right before ❯.
# You can use predefined icon names OR custom characters/glyphs:
#
# Predefined Icon Names (Nerd Font / Unicode):
#   - "laptop"   / "macbook"  -> 󰌢
#   - "desktop"  / "mac-mini" -> 
#   - "server"   / "station"  -> 󰒋
#   - "work"     / "office"   -> 󱥒
#   - "home"                  -> 󰋜
#   - "apple"    / "mac"      -> 
#   - "linux"    / "tux"      -> 
#   - "terminal" / "cli"      -> 
#   - "robot"    / "agent"    -> 󰚩
#
# Custom Glyphs: You can also specify any literal character or glyph directly (e.g. "󰌢", "⚡", "💻").
MACHINE_ICON="laptop"

# MACHINE_ICON_COLOR: Terminal color for the icon.
# Options:
#   - Named colors: "white", "yellow", "cyan", "green", "magenta", "red", "blue"
#   - Hex colors:   "#88C0D0", "#EBCB8B", "#A3BE8C", "#B48EAD", "#5E81AC"
#   - 256-color:    "179", "110", "151"
MACHINE_ICON_COLOR="white"

# ------------------------------------------------------------------------------
# 2. Machine Role & System Policies
# ------------------------------------------------------------------------------
# MACHINE_ROLE: The primary function of this machine.
#
# Options:
#   - "client" : Portable laptop / roaming machine.
#                Uses standard energy saver settings and client SSH configurations.
#   - "server" : Always-on workstation or headless station (e.g. Mac Mini, Linux box).
#                setup-machine.sh configures pmset to prevent system sleep, enables
#                Wake-on-LAN (WOMP), auto-restart on power loss, and active Remote Login.
MACHINE_ROLE="client"
